# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Python source
*.py text eol=lf diff=python

# Markdown documentation
*.md text eol=lf

# Config & data files
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.lock text eol=lf
*.svg text eol=lf

# Shell / batch scripts
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Git hooks must stay LF — a CRLF shebang breaks them on Windows
/.githooks/** text eol=lf

# Security: prevent secret files from appearing in diffs if accidentally created
*.env -diff
*.env.* -diff
*.pem -diff
*.key -diff
*.cert -diff
*.crt -diff
*.p12 -diff
*.pfx -diff
*.pkcs12 -diff
*.kdbx -diff
*id_rsa* -diff
*id_ed25519* -diff
*credentials*.json -diff
*client_secret*.json -diff
*service-account*.json -diff
*token*.json -diff

# Binary model artifacts & images — never diff or apply text transforms
*.joblib binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff2 binary
*.pdf binary
*.parquet binary
*.pkl binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# Archive export ignores: exclude development, CI, and test tooling from release archives
.github/ export-ignore
.gitleaks.toml export-ignore
.pre-commit-config.yaml export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.git-blame-ignore-revs export-ignore
.gitmessage export-ignore
tests/ export-ignore
