    "/api/v1/transactions": {
      "get": {
        "summary": "Transactions",
        "description": "Paginated ledger view (C.1.3): a single response is bounded to\n``limit`` rows (default 500, max 5000) with ``total`` + ``truncated``\nso clients can page instead of pulling the whole ledger at once.",
        "operationId": "transactions_api_v1_transactions_get",
        "parameters": [
          {
            "name": "focal_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Focal Only"
            }
          },
          {
            "name": "user",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Focal user",
              "enum": [
                "U_Alex",
                "U_Maria"
              ],
              "title": "User"
            },
            "description": "Focal user"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5000,
              "minimum": 1,
              "description": "Max rows per page",
              "default": 500,
              "title": "Limit"
            },
            "description": "Max rows per page"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Row offset for paging",
              "default": 0,
              "title": "Offset"
            },
            "description": "Row offset for paging"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Transactions Api V1 Transactions Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
