    "/api/v1/similar-transactions": {
      "get": {
        "summary": "Similar Transactions",
        "description": "Phase B.1 \u2014 nearest transactions in feature space with fraud labels.\n\n``transaction_id`` is the original ledger row position (omit to explain\nthe highest-risk flagged transaction). Gated by config.yaml\n``features.faiss_retrieval``.",
        "operationId": "similar_transactions_api_v1_similar_transactions_get",
        "parameters": [
          {
            "name": "transaction_id",
            "in": "query",
            "required": false,
            "schema": {
