# FinSight Agent — environment variables (copy to .env and fill in; .env is gitignored).
# Every variable here is optional; the app degrades gracefully when unset.
#
# Do NOT hand-type secret values — run `./scripts/generate_secrets.sh` and copy
# the minted values (it never persists them). See `make generate-secrets` and
# DEPLOY.md §3 for the full runbook.

# --- App (Streamlit) ---------------------------------------------------------
# Demo-grade shared-password gate for the UI. Leave unset to show the
# "DEMO MODE — NOT SECURED" banner instead. Demo-grade only — not enterprise auth.
APP_PASSWORD=

# Mark a public deployment (shows the BYO-key banner on Ask-the-Agent).
FINSIGHT_PUBLIC=

# --- Facts API (finance_agent/api.py) ----------------------------------------
# Optional shared secret for the API (X-API-Key header). Unset = no gate.
FINSIGHT_API_KEY=

# Base URL of the API when the Streamlit app runs as its HTTP client
# (e.g. http://api:8000 in docker compose). Unset = app uses local facts.
FINSIGHT_API_URL=

# Per-IP request limit for /api/* per minute (sliding window, in-process).
# 0 (default) disables rate limiting — set this in production, e.g. 600.
FINSIGHT_RATE_LIMIT_PER_MIN=600

# Comma-separated CORS allow-list for the API (browser clients incl. /docs).
# Unset = "*" (local-dev default; only safe with allow_credentials=False).
FINSIGHT_CORS_ORIGINS=

# --- LLM agent (optional) -----------------------------------------------------
# Without this the agent runs the deterministic offline narrator.
ANTHROPIC_API_KEY=

# --- Outbound webhooks / digest -------------------------------------------------
# Risk-alert webhook (Slack Incoming Webhook or any HTTP receiver) — also set
# features.webhook_alerts: true in config.yaml.
FINSIGHT_WEBHOOK_URL=

# Weekly digest delivery (config.yaml digest.*).
DIGEST_SLACK_WEBHOOK=
DIGEST_SMTP_PASSWORD=

# --- Observability ------------------------------------------------------------
# Sentry DSN; unset = error reporting inert.
SENTRY_DSN=
# dev | staging | production — recorded on Sentry events.
ENVIRONMENT=dev
